---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Base title="Blog">
  <h1>Blog</h1>
  <ul class="posts">
    {posts.map((post) => (
      <li>
        <a class="title" href={'/blog/' + post.id}>{post.data.title}</a>
        {post.data.description && <p class="dim" style="margin:.3rem 0 0;font-size:.9rem">{post.data.description}</p>}
        <div class="meta">{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })} · {post.data.tags.join(', ')}</div>
      </li>
    ))}
  </ul>
</Base>
